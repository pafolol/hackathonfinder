# Copia este archivo como .env y llena los valores.

# Cadena de conexión del Postgres alojado (Neon, Railway, Render, etc.).
# Se acepta el formato normal postgresql://usuario:clave@host/db?sslmode=require
DATABASE_URL=postgresql://usuario:clave@host:5432/basededatos?sslmode=require

OPENAI_API_KEY=
# Modelo con soporte de búsqueda web en la Responses API.
OPENAI_MODEL=gpt-5.6-luna

# Cadena larga y aleatoria: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_HOURS=12

# Primer administrador; se crea al arrancar si todavía no hay usuarios.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador

# Origen del frontend (separa varios con coma).
CORS_ORIGINS=http://localhost:5173
# Ponlo en true cuando el sitio se sirva por HTTPS.
COOKIE_SECURE=false
